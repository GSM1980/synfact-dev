+pub struct CacheModel {
+    pub iline: std::collections::HashMap<u32, u64>,
+    pub dline: std::collections::HashMap<u32, u64>,
+    pub ifree: std::collections::HashSet<u32>,
+    pub ilock: std::collections::HashSet<u32>,
+    pub ic: [[u32; 4]; 128],
+    pub dc: [[u32; 4]; 128],
+    pub im: u64,
+    pub dm: u64,
+    pub dhalf: bool,
+}
+impl CacheModel {
+    pub fn new() -> Self { CacheModel { iline: Default::default(), dline: Default::default(), ifree: Default::default(), ilock: Default::default(), ic: [[u32::MAX; 4]; 128], dc: [[u32::MAX; 4]; 128], im: 0, dm: 0, dhalf: std::env::var_os("XPROF_DHALF").is_some() } }
+    #[inline(always)]
+    fn look(set: &mut [u32; 4], tag: u32) -> bool {
+        // index 0 = most recent
+        for w in 0..4 {
+            if set[w] == tag {
+                let t = set[w];
+                let mut k = w; while k > 0 { set[k] = set[k - 1]; k -= 1; }
+                set[0] = t; return true;
+            }
+        }
+        set[3] = set[2]; set[2] = set[1]; set[1] = set[0]; set[0] = tag; false
+    }
+    #[inline(always)]
+    pub fn d(&mut self, a: u32) {
+        let l = a >> 4;
+        let hit = if self.dhalf { Self::look2(&mut self.dc[(l & 127) as usize], l) } else { Self::look(&mut self.dc[(l & 127) as usize], l) };
+        if !hit { self.dm += 1; *self.dline.entry(l).or_insert(0) += 1; }
+    }
+    #[inline(always)]
+    pub fn i(&mut self, a: u32) {
+        let l = a >> 4;
+        if self.ifree.contains(&l) || self.ilock.contains(&l) { return; }
+        let hit = if self.ilock.is_empty() { Self::look(&mut self.ic[(l & 127) as usize], l) } else { Self::look2(&mut self.ic[(l & 127) as usize], l) };
+        if !hit { self.im += 1; *self.iline.entry(l).or_insert(0) += 1; }
+    }
+    #[inline(always)]
+    fn look2(set: &mut [u32; 4], tag: u32) -> bool {
+        if set[0] == tag { return true; }
+        if set[1] == tag { set[1] = set[0]; set[0] = tag; return true; }
+        set[1] = set[0]; set[0] = tag; false
+    }
+    pub fn load_sets(&mut self) {
+        for (var, lock) in [("XPROF_IFREE", false), ("XPROF_ILOCK", true)] {
+            if let Ok(f) = std::env::var(var) {
+                for t in std::fs::read_to_string(f).unwrap().split_whitespace() {
+                    let l = u32::from_str_radix(t, 16).unwrap();
+                    if lock { self.ilock.insert(l); } else { self.ifree.insert(l); }
+                }
+            }
+        }
+    }
+}
