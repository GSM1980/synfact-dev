+//! Exact differential test of a replacement for a stock function.
+//!
+//! XDIFF="start=HEX,repl=HEX,code=FILE[,every=N][,limit=N][,max=N][,dead=HEXMASK][,cont=repl]"
+//! Every N-th call of `start` (a function entry, return address at (A7)):
+//! the replacement (FILE loaded at `repl`) and then the stock function run
+//! from the same state, single-stepped with the peripherals frozen (no
+//! events, no interrupts, I/O writes of the replacement logged but not
+//! performed). Their results are compared: D0-D7/A0-A7 (minus `dead`, bit n
+//! = Dn, bit 8+n = An), SR, MACSR, MASK, the four accumulators, all of SRAM,
+//! all of DDR except the dead stack below the entry SP, and the I/O writes.
+//! The run continues from the stock result (or the replacement's, cont=repl).
+
+use crate::machine::Machine;
+
+pub struct XDiff {
+    pub start: u32,
+    pub repl: u32,
+    base: u32,
+    code: Vec<u8>,
+    every: u64,
+    limit: u64,
+    max: u64,
+    dead: u32,
+    cont_repl: bool,
+    after: u64,
+    loaded: bool,
+    pub seen: u64,
+    pub cases: u64,
+    pub fails: u64,
+    pub timeouts: u64,
+    pub stock_instr: u64,
+    pub repl_instr: u64,
+    pub ccr_diffs: u64,
+}
+
+impl XDiff {
+    pub fn from_env() -> Option<Box<XDiff>> {
+        let spec = std::env::var("XDIFF").ok()?;
+        let mut x = XDiff {
+            start: 0, repl: 0, base: 0, code: Vec::new(), every: 1, limit: u64::MAX, max: 5_000_000,
+            dead: 0, cont_repl: false, after: 0, loaded: false, seen: 0, cases: 0, fails: 0, timeouts: 0,
+            stock_instr: 0, repl_instr: 0, ccr_diffs: 0,
+        };
+        for kv in spec.split(',') {
+            let (k, v) = kv.split_once('=').expect("XDIFF key=value");
+            let hex = || u32::from_str_radix(v.trim_start_matches("0x"), 16).unwrap();
+            match k {
+                "start" => x.start = hex(),
+                "repl" => x.repl = hex(),
+                "base" => x.base = hex(),
+                "code" => x.code = std::fs::read(v).expect("XDIFF code"),
+                "every" => x.every = v.parse().unwrap(),
+                "limit" => x.limit = v.parse().unwrap(),
+                "max" => x.max = v.parse().unwrap(),
+                "dead" => x.dead = hex(),
+                "cont" => x.cont_repl = v == "repl",
+                "after" => x.after = v.trim_end_matches('M').parse::<u64>().unwrap() * if v.ends_with('M') { 1_000_000 } else { 1 },
+                _ => panic!("XDIFF: unknown key {k}"),
+            }
+        }
+        if x.base == 0 { x.base = x.repl; }
+        Some(Box::new(x))
+    }
+    pub fn report(&self) -> String {
+        format!(
+            "xdiff: {} calls seen, {} cases, {} FAILED, {} timeouts, {} CCR-only differences; instructions per call stock {:.1}, replacement {:.1}",
+            self.seen, self.cases, self.fails, self.timeouts, self.ccr_diffs,
+            self.stock_instr as f64 / self.cases.max(1) as f64,
+            self.repl_instr as f64 / self.cases.max(1) as f64
+        )
+    }
+}
+
+#[derive(Clone)]
+struct Regs {
+    d: [u32; 8],
+    a: [u32; 8],
+    pc: u32,
+    sr: u16,
+    macsr: u32,
+    mask: u32,
+    accv: [i64; 4],
+}
+
+fn regs(m: &Machine) -> Regs {
+    let c = &m.cpu;
+    Regs { d: c.d, a: c.a, pc: c.pc, sr: c.sr, macsr: c.macsr, mask: c.mask, accv: c.accv }
+}
+
+fn set_regs(m: &mut Machine, r: &Regs) {
+    let c = &mut m.cpu;
+    c.d = r.d;
+    c.a = r.a;
+    c.pc = r.pc;
+    c.sr = r.sr;
+    c.macsr = r.macsr;
+    c.mask = r.mask;
+    c.accv = r.accv;
+}
+
+/// Step from `pc` until the function returns to `ret` with SP back at `sp`.
+thread_local! { pub static TRACE: std::cell::RefCell<Option<Vec<(u32, [u32; 16], [i64; 4], u32)>>> = const { std::cell::RefCell::new(None) }; }
+
+fn run_to(m: &mut Machine, pc: u32, ret: u32, sp: u32, max: u64) -> Option<u64> {
+    m.cpu.pc = pc;
+    let t0 = m.cpu.bus.io.now;
+    while m.cpu.bus.io.now - t0 < max {
+        if m.cpu.pc == ret && m.cpu.a[7] == sp {
+            return Some(m.cpu.bus.io.now - t0);
+        }
+        TRACE.with(|t| if let Some(v) = t.borrow_mut().as_mut() {
+            let mut r = [0u32; 16];
+            r[..8].copy_from_slice(&m.cpu.d);
+            r[8..].copy_from_slice(&m.cpu.a);
+            v.push((m.cpu.pc, r, m.cpu.accv, m.cpu.macsr));
+        });
+        m.cpu.step();
+        if m.cpu.last_fault.take().is_some() {
+            return None;
+        }
+    }
+    None
+}
+
+/// XDIFF_FUZZ="K:LEN:MODE;..." fills the LEN bytes that stack argument K
+/// (1 = the first, at 4(A7)) points to, before both runs, then restores the
+/// real state afterwards. MODE: r random words; g gains (random, with the
+/// extremes often); i ramp increments (all zero on odd cases, else random,
+/// some zero); s samples (random, with the extremes often).
+fn fuzz(m: &mut Machine, case: u64) -> bool {
+    let Ok(spec) = std::env::var("XDIFF_FUZZ") else { return false };
+    let mut st = 0x9E37_79B9_7F4A_7C15u64 ^ case.wrapping_mul(0xD1B5_4A32_D192_ED03);
+    let mut rnd = || { st ^= st << 13; st ^= st >> 7; st ^= st << 17; st };
+    let sp = m.cpu.a[7];
+    for item in spec.split(';') {
+        let f: Vec<&str> = item.split(':').collect();
+        let k: u32 = f[0].parse().unwrap();
+        let len: u32 = f[1].parse().unwrap();
+        let base = m.cpu.bus.peek32(sp + 4 * k);
+        let zero_incs = case % 2 == 1;
+        for w in 0..len / 4 {
+            let r = rnd();
+            let v = match f[2] {
+                "g" | "s" => match r % 8 { 0 => 0x7FFF_FFFF, 1 => 0x8000_0000, 2 => 0, _ => (r >> 16) as u32 },
+                "i" => if zero_incs || r % 4 == 0 { 0 } else { ((r >> 20) as u32 & 0x7F_FFFF).wrapping_sub(0x40_0000) },
+                _ => (r >> 16) as u32,
+            };
+            m.cpu.bus.poke32(base + 4 * w, v);
+        }
+    }
+    true
+}
+
+pub fn case(m: &mut Machine) {
+    let now = m.cpu.bus.io.now;
+    let x = m.xdiff.as_mut().unwrap();
+    if now < x.after {
+        return;
+    }
+    x.seen += 1;
+    if x.cases >= x.limit || x.seen % x.every != 0 {
+        return;
+    }
+    if !x.loaded {
+        let (base, code) = (x.base, x.code.clone());
+        for (i, b) in code.iter().enumerate() {
+            m.cpu.bus.poke8(base + i as u32, *b);
+        }
+        m.xdiff.as_mut().unwrap().loaded = true;
+    }
+    let x = m.xdiff.as_ref().unwrap();
+    let (start, repl, max, dead, cont_repl) = (x.start, x.repl, x.max, x.dead, x.cont_repl);
+    let noddr = std::env::var_os("XDIFF_NODDR").is_some();
+    let pre = if std::env::var_os("XDIFF_FUZZ").is_some() {
+        Some((regs(m), m.cpu.bus.sram.clone(), m.cpu.bus.ddr.clone()))
+    } else { None };
+    let ncase = m.xdiff.as_ref().unwrap().cases;
+    fuzz(m, ncase);
+    let r0 = regs(m);
+    let sp0 = r0.a[7];
+    if std::env::var_os("XDIFF_DUMP").is_some() && ncase < 8 {
+        let a: Vec<u32> = (1..5).map(|k| m.cpu.bus.peek32(sp0 + 4 * k)).collect();
+        println!("xdiff args case {ncase}: ret {:08x} args {:08x?}", m.cpu.bus.peek32(sp0), a);
+        for (k, p) in a.iter().enumerate() {
+            let w: Vec<u32> = (0..10).map(|i| m.cpu.bus.peek32(p + 4 * i)).collect();
+            println!("   *arg{}: {:08x?}", k + 1, w);
+        }
+    }
+    let ret = m.cpu.bus.peek32(sp0);
+    let sram0 = m.cpu.bus.sram.clone();
+    let ddr0 = if noddr { Vec::new() } else { m.cpu.bus.ddr.clone() };
+    let (now0, dl0) = (m.cpu.bus.io.now, m.cpu.bus.io.deadline);
+    m.cpu.bus.io.deadline = u64::MAX;
+
+    // The replacement, I/O writes logged only.
+    m.cpu.bus.xio = Some(Vec::new());
+    m.cpu.bus.xior = Some(Vec::new());
+    let tracing = std::env::var_os("XDIFF_TRACE").is_some() && m.xdiff.as_ref().unwrap().cases == 0;
+    if tracing { TRACE.with(|t| *t.borrow_mut() = Some(Vec::new())); }
+    m.cpu.bus.xio_suppress = std::env::var_os("XDIFF_SUPPRESS_IO").is_some();
+    let tr = run_to(m, repl, ret, sp0 + 4, max);
+    let tr_trace = TRACE.with(|t| t.borrow_mut().replace(Vec::new()));
+    m.cpu.bus.xio_suppress = false;
+    let io_r = m.cpu.bus.xio.replace(Vec::new()).unwrap();
+    let ior_r = m.cpu.bus.xior.replace(Vec::new()).unwrap();
+    let rr = regs(m);
+    let sram_r = m.cpu.bus.sram.clone();
+    let ddr_r = if noddr { Vec::new() } else { m.cpu.bus.ddr.clone() };
+
+    // The stock function from the same state.
+    if !noddr { m.cpu.bus.ddr.copy_from_slice(&ddr0); }
+    drop(ddr0);
+    m.cpu.bus.sram.copy_from_slice(&sram0);
+    set_regs(m, &r0);
+    m.cpu.bus.io.now = now0;
+    let ts = run_to(m, start, ret, sp0 + 4, max);
+    let ts_trace = TRACE.with(|t| t.borrow_mut().take());
+    if let (Some(a), Some(b)) = (tr_trace, ts_trace) {
+        let a = &a[1..];
+        if let Some(k) = a.iter().zip(b.iter()).position(|(x, y)| x != y) {
+            println!("xdiff trace: first divergence at step {k}: repl pc {:08x} regs {:08x?} acc {:x?} macsr {:x}", a[k].0, a[k].1, a[k].2, a[k].3);
+            println!("                                     stock pc {:08x} regs {:08x?} acc {:x?} macsr {:x}", b[k].0, b[k].1, b[k].2, b[k].3);
+            if k > 0 { println!("  previous pc {:08x}", b[k - 1].0); }
+        } else { println!("xdiff trace: no divergence in {} steps", b.len()); }
+    }
+    let io_s = m.cpu.bus.xio.take().unwrap();
+    let ior_s = m.cpu.bus.xior.take().unwrap();
+    let rs = regs(m);
+
+    let mut out = Vec::new();
+    let x = m.xdiff.as_mut().unwrap();
+    x.cases += 1;
+    match (tr, ts) {
+        (Some(a), Some(b)) => {
+            x.repl_instr += a;
+            x.stock_instr += b;
+        }
+        _ => {
+            x.timeouts += 1;
+            out.push(format!("timeout/fault: replacement {tr:?}, stock {ts:?}"));
+        }
+    }
+    for i in 0..8 {
+        if dead & (1 << i) == 0 && rr.d[i] != rs.d[i] {
+            out.push(format!("d{i}: repl {:08x} stock {:08x}", rr.d[i], rs.d[i]));
+        }
+        if dead & (1 << (8 + i)) == 0 && rr.a[i] != rs.a[i] {
+            out.push(format!("a{i}: repl {:08x} stock {:08x}", rr.a[i], rs.a[i]));
+        }
+    }
+    if rr.sr & 0xFF00 != rs.sr & 0xFF00 {
+        out.push(format!("sr: repl {:04x} stock {:04x}", rr.sr, rs.sr));
+    } else if rr.sr != rs.sr {
+        x.ccr_diffs += 1;
+    }
+    if rr.macsr != rs.macsr || rr.mask != rs.mask {
+        out.push(format!("macsr/mask: repl {:08x}/{:08x} stock {:08x}/{:08x}", rr.macsr, rr.mask, rs.macsr, rs.mask));
+    }
+    for i in 0..4 {
+        if rr.accv[i] != rs.accv[i] {
+            out.push(format!("acc{i}: repl {:x} stock {:x}", rr.accv[i], rs.accv[i]));
+        }
+    }
+    let diffs = |name: &str, base: u32, a: &[u8], b: &[u8], skip: (usize, usize), out: &mut Vec<String>| {
+        let mut n = 0;
+        let mut i = 0;
+        while i < a.len().min(b.len()) {
+            if (i < skip.0 || i >= skip.1) && a[i] != b[i] {
+                if n < 12 {
+                    let w = i & !3;
+                    let rd = |v: &[u8]| u32::from_be_bytes(v[w..w + 4].try_into().unwrap());
+                    out.push(format!("{name} {:08x}: repl {:08x} stock {:08x}", base + w as u32, rd(a), rd(b)));
+                }
+                n += 1;
+                i = (i | 3) + 1;
+                continue;
+            }
+            i += 1;
+        }
+        if n > 12 {
+            out.push(format!("{name}: {n} differing words in all"));
+        }
+    };
+    diffs("sram", 0x8000_0000, &sram_r, &m.cpu.bus.sram, (0, 0), &mut out);
+    let so = (sp0 - 0x4000_0000) as usize;
+    if !noddr { diffs("ddr", 0x4000_0000, &ddr_r, &m.cpu.bus.ddr, (so - 0x4000, so), &mut out); }
+    if ior_r != ior_s {
+        let k = ior_r.iter().zip(ior_s.iter()).position(|(a, b)| a != b).unwrap_or(ior_r.len().min(ior_s.len()));
+        out.push(format!("io reads differ at #{k} of {}/{}: repl {:x?} stock {:x?}", ior_r.len(), ior_s.len(), ior_r.get(k), ior_s.get(k)));
+    }
+    if io_r != io_s {
+        out.push(format!("io writes differ: repl {:x?} stock {:x?}", &io_r[..io_r.len().min(8)], &io_s[..io_s.len().min(8)]));
+    }
+    let x = m.xdiff.as_mut().unwrap();
+    if !out.is_empty() && !(out.len() == 1 && out[0].starts_with("timeout")) {
+        x.fails += 1;
+    }
+    if !out.is_empty() && x.fails + x.timeouts <= 5 {
+        println!("xdiff case {} (call {}) at clock {now0}:", x.cases, x.seen);
+        if std::env::var_os("XDIFF_ARGS").is_some() {
+            println!("  acc_in = {:x} {:x} {:x} {:x} macsr={:08x} mask={:08x}", r0.accv[0], r0.accv[1], r0.accv[2], r0.accv[3], r0.macsr, r0.mask);
+            for k in 1..5u32 {
+                let p = m.cpu.bus.peek32(sp0 + 4 * k);
+                let w: Vec<u32> = (0..8).map(|i| m.cpu.bus.peek32(p + 4 * i)).collect();
+                println!("  arg{k} @ {p:08x}: {w:08x?}");
+            }
+            let outp = m.cpu.bus.peek32(sp0 + 4);
+            let rd = |buf: &[u8], a: u32| { let o = (a & (super::bus::SRAM_SIZE as u32 - 1)) as usize; u32::from_be_bytes(buf[o..o+4].try_into().unwrap()) };
+            let r: Vec<u32> = (0..8).map(|i| rd(&sram_r, outp + 8 * i)).collect();
+            let s: Vec<u32> = (0..8).map(|i| rd(&m.cpu.bus.sram, outp + 8 * i)).collect();
+            println!("  out repl : {r:08x?}");
+            println!("  out stock: {s:08x?}");
+        }
+        for l in &out {
+            println!("  {l}");
+        }
+    }
+    if cont_repl && tr.is_some() {
+        m.cpu.bus.ddr.copy_from_slice(&ddr_r);
+        m.cpu.bus.sram.copy_from_slice(&sram_r);
+        set_regs(m, &rr);
+        m.cpu.bus.io.now = now0 + tr.unwrap();
+    }
+    if let Some((r, sram, ddr)) = pre {
+        m.cpu.bus.ddr.copy_from_slice(&ddr);
+        m.cpu.bus.sram.copy_from_slice(&sram);
+        set_regs(m, &r);
+        m.cpu.bus.io.now = now0;
+        m.cpu.pc = start;
+    }
+    let d = m.cpu.bus.io.deadline;
+    m.cpu.bus.io.deadline = dl0.min(d);
+}
