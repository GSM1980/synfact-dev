+#[derive(Default)]
+pub struct XProf {
+    pub selfc: std::collections::HashMap<u32, u64>,
+    pub incl: std::collections::HashMap<u32, u64>,
+    pub calls: std::collections::HashMap<u32, u64>,
+    pub edges: std::collections::HashMap<(u32, u32), u64>,
+    pub by_tcb: std::collections::HashMap<u32, u64>,
+    pub total: u64,
+    pub tim: u64,
+    pub tdm: u64,
+    pub selfm: std::collections::HashMap<u32, (u64, u64)>,
+    pub inclm: std::collections::HashMap<u32, (u64, u64)>,
+    stacks: std::collections::HashMap<u32, Vec<(u32, u32, bool)>>,
+    pub last_a7: u32,
+    pub last_npc: u32,
+    pub last_tcb: u32,
+    pub overflow: u64,
+}
+
+impl XProf {
+    fn push(&mut self, tcb: u32, sp: u32, f: u32, irq: bool) {
+        let st = self.stacks.entry(tcb).or_default();
+        while let Some(t) = st.last() { if t.0 <= sp { st.pop(); } else { break; } }
+        let caller = st.last().map_or(0, |t| t.1);
+        if st.len() < 256 { st.push((sp, f, irq)); } else { self.overflow += 1; }
+        *self.calls.entry(f).or_insert(0) += 1;
+        *self.edges.entry((caller, f)).or_insert(0) += 1;
+    }
+    fn pop_to(&mut self, tcb: u32, a7: u32) {
+        if let Some(st) = self.stacks.get_mut(&tcb) {
+            while let Some(t) = st.last() {
+                // a frame is gone once SP is above its return slot
+                if a7 > t.0 || a7 < t.0.wrapping_sub(0x10000) { st.pop(); } else { break; }
+            }
+        }
+    }
+    fn account(&mut self, pc: u32, d: u64, tcb: u32, im: u64, dm: u64) {
+        self.total += d;
+        self.tim += im; self.tdm += dm;
+        *self.selfc.entry(pc).or_insert(0) += d;
+        if im + dm > 0 { let e = self.selfm.entry(pc).or_insert((0, 0)); e.0 += im; e.1 += dm; }
+        *self.by_tcb.entry(tcb).or_insert(0) += d;
+        if let Some(st) = self.stacks.get(&tcb) {
+            let mut seen: [u32; 256] = [0; 256];
+            let mut n = 0;
+            for t in st.iter().rev() {
+                if !seen[..n].contains(&t.1) {
+                    *self.incl.entry(t.1).or_insert(0) += d;
+                    if im + dm > 0 { let e = self.inclm.entry(t.1).or_insert((0, 0)); e.0 += im; e.1 += dm; }
+                    seen[n] = t.1; n += 1;
+                }
+                if t.2 { break; }
+            }
+        }
+    }
+    fn leave(&mut self, pc: u32, a7b: u32, npc: u32, ret: Option<u32>, tcb: u32) {
+        if let Some(r) = ret {
+            if r > pc && r < pc.wrapping_add(0x400) && npc != r {
+                self.push(tcb, a7b, npc, false);
+            }
+        }
+        self.last_a7 = a7b;
+        self.last_npc = npc;
+        self.last_tcb = tcb;
+    }
+}
