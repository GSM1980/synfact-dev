    "modules": ["st_subtype_module"],
    "features": ["machine-ui-v1"],
    "machines": [{"descriptor": "md_machinedrum", "ui": "md_machinedrum_ui", "update": "md_update", "render": "md_render"}],
    "audio": {"sources": ["audio/md.c", "audio/md-runtime.c", "audio/md-tables.c",
                          "audio/voices/mdkit_trx_bd.c", "audio/voices/mdkit_trx_sd.c", "audio/voices/mdkit_trx_xt.c",
                          "audio/voices/mdkit_trx_cp.c", "audio/voices/mdkit_trx_rs.c", "audio/voices/mdkit_trx_cb.c",
                          "audio/voices/mdkit_trx_ch.c", "audio/voices/mdkit_trx_oh.c", "audio/voices/mdkit_trx_cy.c",
                          "audio/voices/mdkit_trx_ma.c", "audio/voices/mdkit_trx_cl.c", "audio/voices/mdkit_trx_xc.c",
                          "audio/voices/mdkit_trx_b2.c", "audio/native/efm_bd.c", "audio/voices/mdkit_efm_sd.c",
                          "audio/voices/mdkit_efm_xt.c", "audio/voices/mdkit_efm_cp.c", "audio/voices/mdkit_efm_rs.c",
                          "audio/voices/mdkit_efm_cb.c", "audio/voices/mdkit_efm_hh.c", "audio/voices/mdkit_efm_cy.c",
                          "audio/voices/mdkit_pi_bd.c", "audio/voices/mdkit_pi_sd.c", "audio/voices/mdkit_pi_mt.c",
                          "audio/voices/mdkit_pi_ml.c", "audio/voices/mdkit_pi_ma.c", "audio/voices/mdkit_pi_rs.c",
                          "audio/voices/mdkit_pi_rc.c", "audio/voices/mdkit_pi_cc.c", "audio/voices/mdkit_pi_hh.c"]}
  }
