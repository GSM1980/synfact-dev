{
  "id": "samplers-st", "version": "1.0", "license": "GPL-2.0-or-later",
  "title": "SP sample machines", "category": "Synth", "author": "GSM1980",
  "description": "Source-built ONE SHOT, WERP, REPITCH and SLICE for the generic Syntakt project sample pool.",
  "device": "syntakt", "os": "1.41", "sources": ["main.c", "ui.c", "input.c"],
  "smz": {
    "modules": ["sp_sampler_input_module"],
    "features": ["sample-pool-v1", "machine-ui-v1"],
    "machines": [
      {"descriptor": "sp_one_shot", "ui": "sp_one_ui", "update": "sp_one_shot_update", "render": "sp_one_shot_render"},
      {"descriptor": "sp_werp", "ui": "sp_werp_ui", "update": "sp_werp_update", "render": "sp_werp_render"},
      {"descriptor": "sp_repitch", "ui": "sp_repitch_ui", "update": "sp_repitch_update", "render": "sp_repitch_render"},
      {"descriptor": "sp_slice", "ui": "sp_slice_ui", "update": "sp_slice_update", "render": "sp_slice_render"}
    ],
    "audio": {"sources": ["audio/sampler.c", "audio/one-shot.c", "audio/werp.c", "audio/repitch.c", "audio/slice.c"]}
  }
}
